{
  "expo": {
    "name": "Goalloom",
    "slug": "goalloom",
    "scheme": "goalloom",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.goalloom.mobile"
    },
    "android": {
      "package": "app.goalloom.mobile"
    },
    "web": { "bundler": "metro" },
    "plugins": [
      "expo-sqlite"
    ]
  }
}
