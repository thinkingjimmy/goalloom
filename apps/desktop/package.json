{
  "name": "@goalloom/desktop",
  "version": "1.9.4",
  "private": true,
  "description": "把三个月的方向，连接到今天的行动。",
  "author": "Goalloom",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev --watch",
    "typecheck": "tsc --noEmit -p ../../tsconfig.json",
    "test": "node scripts/test.mjs",
    "test:domain": "node scripts/test.mjs apps/desktop/tests/domain",
    "test:integration": "node scripts/test.mjs apps/desktop/tests/integration",
    "test:repository": "node scripts/test.mjs apps/desktop/tests/integration",
    "test:electron": "node tests/sqlite.mjs",
    "test:ui": "node tests/workspace.mjs",
    "test:task-focus": "node tests/task-focus.mjs",
    "test:later": "node tests/later-sidebar.mjs",
    "test:columns": "node tests/column-visibility.mjs",
    "build": "pnpm run typecheck && electron-vite build && node scripts/build/third-party-notices.mjs && node scripts/build/check-production.mjs",
    "package:dir": "pnpm run build && electron-builder --dir --publish never",
    "package:mac": "pnpm run build && electron-builder --mac --arm64 --publish never && node scripts/build/package-report.mjs release latest darwin-arm64",
    "package:win": "pnpm run build && electron-builder --win --x64 --publish never && node scripts/build/package-report.mjs release latest win32-x64",
    "test:history": "node tests/history.mjs",
    "test:autosave": "node tests/autosave.mjs",
    "test:descriptions": "node tests/descriptions.mjs",
    "test:links": "node tests/link-previews.mjs",
    "test:recovery": "node tests/recovery.mjs",
    "test:performance": "node tests/performance.mjs",
    "test:startup": "node tests/startup.mjs",
    "test:credentials": "node tests/credentials.mjs",
    "test:keychain-native": "node tests/keychain-native.mjs",
    "test:keychain-package": "node tests/keychain-package.mjs",
    "test:composer": "node tests/composer.mjs",
    "test:auto-link": "node tests/auto-link.mjs",
    "test:due-dates": "node tests/due-dates.mjs",
    "test:language": "node tests/language.mjs",
    "test:relations": "node tests/relations.mjs",
    "test:celebration": "node tests/celebration.mjs",
    "test:feedback": "node tests/feedback.mjs",
    "test:updates": "node tests/updates.mjs",
    "test:update-install": "node tests/update-install.mjs",
    "test:review": "node tests/review/run.mjs renderer lifecycle virtual wire large-workspace package-report",
    "test:large-backup": "node tests/review/run.mjs large-backup",
    "test:scaling": "node tests/review/run.mjs scaling",
    "build:debug": "pnpm build && node scripts/build/debug-artifacts.mjs",
    "package:check": "node scripts/build/package-report.mjs",
    "package:experiment": "node scripts/build/package-experiment.mjs",
    "eval:smart": "node scripts/eval/run.mjs",
    "eval:capture": "node scripts/eval/capture/run.mjs",
    "test:composer-live": "node tests/composer-live.mjs",
    "test:subtasks": "node tests/subtasks.mjs",
    "test:completed-layout": "node tests/completed-layout.mjs",
    "test:ordering": "node tests/ordering.mjs",
    "test:periods": "node tests/periods.mjs",
    "test:insight": "node tests/insight.mjs",
    "test:insight-live": "node tests/insight-live.mjs",
    "test:insight-generation": "node tests/insight-generation.mjs",
    "test:calendar": "node tests/calendar-modes.mjs",
    "test:assistance": "node tests/assistance/run.mjs",
    "eval:assistance": "node scripts/eval/assistance/run.mjs",
    "test:sync-replay": "node tests/sync-replay.mjs",
    "test:sync-scheduling": "node tests/sync-cost.mjs baseline && node tests/sync-cost.mjs scheduling && node tests/sync-cost.mjs batching && node tests/sync-cost.mjs protection && node tests/sync-cost-native.mjs && node tests/sync-cost-report.mjs",
    "test:sync-join": "node tests/sync-join.mjs && node tests/sync-join-native.mjs",
    "test:sync-security": "node tests/sync-security.mjs && node tests/sync-security-native.mjs",
    "test:sync-security:packaged": "node tests/sync-security-native.mjs --packaged"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@goalloom/contracts": "workspace:*",
    "@goalloom/crypto": "workspace:*",
    "@goalloom/schema": "workspace:*",
    "@goalloom/store-core": "workspace:*",
    "@goalloom/sync": "workspace:*",
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "@lexical/code": "0.51.0",
    "@lexical/history": "0.51.0",
    "@lexical/link": "0.51.0",
    "@lexical/list": "0.51.0",
    "@lexical/markdown": "0.51.0",
    "@lexical/react": "0.51.0",
    "@lexical/rich-text": "0.51.0",
    "@lexical/selection": "0.51.0",
    "@lexical/utils": "0.51.0",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/supabase-js": "2.117.3",
    "@typesafe-ai/sdk": "0.6.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron-updater": "6.8.10",
    "lexical": "0.51.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.4",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "js-yaml": "4.3.2",
    "node-api-headers": "1.9.0",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  }
}
