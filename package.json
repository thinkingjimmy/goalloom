{
  "name": "goalloom",
  "version": "1.10.0",
  "private": true,
  "description": "把三个月的方向，连接到今天的行动。",
  "author": "Goalloom",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "pnpm --filter @goalloom/desktop run dev",
    "typecheck": "pnpm --filter @goalloom/desktop run typecheck",
    "build": "pnpm --filter @goalloom/desktop run build",
    "build:production": "pnpm --filter @goalloom/desktop run build:production",
    "package:mac": "pnpm --filter @goalloom/desktop run package:mac",
    "package:win": "pnpm --filter @goalloom/desktop run package:win"
  }
}
