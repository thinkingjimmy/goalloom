{
  "name": "goalloom",
  "version": "0.1.0",
  "private": true,
  "description": "把三个月的方向，连接到今天的行动。",
  "author": "Goalloom",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:domain": "node scripts/test.mjs tests/domain",
    "test:integration": "node scripts/test.mjs tests/integration",
    "test:repository": "node scripts/test.mjs tests/integration",
    "test:electron": "node tests/desktop/sqlite.mjs",
    "test:ui": "node tests/desktop/workspace.mjs",
    "build": "npm run typecheck && electron-vite build && node scripts/build/third-party-notices.mjs && node scripts/build/check-production.mjs",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "package:mac": "npm run build && electron-builder --mac --arm64 --publish never",
    "package:win": "npm run build && electron-builder --win --x64 --publish never",
    "test:history": "node tests/desktop/history.mjs",
    "test:recovery": "node tests/desktop/recovery.mjs",
    "test:performance": "node tests/desktop/performance.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "@js-temporal/polyfill": "0.5.1",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.4",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  }
}
